# Dockerfile.ui -- interface Streamlit (app/streamlit_app.py)
#
# Volontairement une image légère : depuis le chapitre 1, Streamlit
# n'importe plus torch/transformers -- il appelle l'API en HTTP. Cette
# image n'a donc besoin que de streamlit et requests, pas de la pile ML.

FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit requests

COPY app/ app/
COPY .streamlit/ .streamlit/

ENV PYTHONUNBUFFERED=1

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
